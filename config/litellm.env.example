# Copy this file to .env.litellm and replace the placeholder values.
# Only keep the provider keys you actually plan to use.

# --- Provider API keys ---
ANTHROPIC_API_KEY=replace_me
OPENAI_API_KEY=replace_me
GEMINI_API_KEY=replace_me

# --- LiteLLM UI credentials ---
UI_USERNAME=admin
UI_PASSWORD=your-chosen-password

# --- LiteLLM master key (must match master_key in litellm.config.yaml) ---
LITELLM_MASTER_KEY=change-this-before-sharing

# --- PostgreSQL database (required for LiteLLM UI/dashboard) ---
# Replace YOUR_MACOS_USERNAME with your macOS username (run `whoami` to check).
DATABASE_URL=postgresql://YOUR_MACOS_USERNAME@localhost:5432/litellm
